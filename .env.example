# Keycloak (OIDC). Set all three to enable real auth; leave any blank to use the
# prototype's mock login. The client must be a public/browser client (PKCE) with
# the app origin in its Valid Redirect URIs and Web Origins.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ifms
VITE_KEYCLOAK_CLIENT_ID=ifms-web

# Backend API (axios baseURL in src/lib/http.ts). Two ways to reach a real backend:
#   1) Dev with no CORS (recommended): point the client at a SAME-ORIGIN path and
#      let the Vite dev server reverse-proxy it to the backend (see vite.config.ts):
#        VITE_API_BASE_URL=/api/v1
#        VITE_API_PROXY_TARGET=https://ifms-backend.example.dev
#   2) Direct: set VITE_API_BASE_URL to the full backend URL — requires the
#      backend to allow this app's origin via CORS.
# Leave VITE_API_BASE_URL blank to keep src/data/api.ts on the in-memory mock data
# (no HTTP requests). VITE_API_PROXY_TARGET (backend ORIGIN) only affects `npm run dev`.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=

# Google Maps JavaScript API key. Optional — maps degrade to a placeholder.
VITE_GOOGLE_MAPS_API_KEY=
